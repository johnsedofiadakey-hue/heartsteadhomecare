# Create a Firebase project and Web app, then copy its public config here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server configuration. App Hosting supplies Google application default credentials.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_OWNER_UID=

# Keep search engines away from previews until content and policies are approved.
SITE_READY_FOR_INDEXING=false
