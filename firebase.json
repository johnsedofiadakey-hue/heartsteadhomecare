{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    }
  },
  "apphosting": [
    {
      "backendId": "heartstead-web",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "review",
        "preview",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
